---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { systems } from '../../data/site';
export function getStaticPaths() {
  return systems.map(system => ({ params: { slug: system.slug }, props: { system } }));
}
const { system } = Astro.props;
---
<BaseLayout title={system.title}>
<section class="section"><div class="container">
  <div class="page-hero">
    <div class="eyebrow">{system.category}</div>
    <h1>{system.title}</h1>
    <p>{system.summary}</p>
  </div>
  <div class="pillars">
    <div class="pillar"><div class="eyebrow">Context</div><h3>Problem</h3><p>{system.problem}</p></div>
    <div class="pillar"><div class="eyebrow">Method</div><h3>Approach</h3><p>{system.approach}</p></div>
    <div class="pillar"><div class="eyebrow">Impact</div><h3>Outcome</h3><p>{system.outcome}</p></div>
    <div class="pillar"><div class="eyebrow">Scope</div><h3>{system.metric}</h3><p>This case study intentionally omits confidential and proprietary information.</p></div>
  </div>
</div></section>
</BaseLayout>
