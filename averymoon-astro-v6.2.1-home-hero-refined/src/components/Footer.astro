---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<footer class="site-footer footer-v55">
  <div class="container footer-composition">
    <div class="footer-mark" aria-hidden="true">
      <svg viewBox="0 0 500 70"><path d="M0 42C85 42 94 14 174 14s91 38 168 38 91-24 158-24"/><circle cx="174" cy="14" r="4"/><circle cx="342" cy="52" r="4"/></svg>
    </div>
    <div class="footer-main">
      <div>
        <div class="footer-name">Avery Moon</div>
        <div class="footer-descriptor">Systems · Knowledge · Process</div>
      </div>
      <p class="footer-tagline">Better systems. Better outcomes. Stronger teams.</p>
    </div>
    <div class="footer-bottom">
      <span>© 2026 Avery Moon</span>
      <nav aria-label="Footer">
        <a href="https://www.linkedin.com/" target="_blank" rel="noopener">LinkedIn</a>
        <a href="https://github.com/avery-moon" target="_blank" rel="noopener">GitHub</a>
        <a href={`${base}/contact/`}>Contact</a>
      </nav>
    </div>
  </div>
</footer>
