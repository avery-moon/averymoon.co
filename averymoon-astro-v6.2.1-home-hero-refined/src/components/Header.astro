---
import { nav } from '../data/site';
const path = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const hrefFor = (href) => href === '/' ? `${base}/` : `${base}${href}`;
---
<header class="site-header">
  <div class="container navbar">
    <a class="brand" href={`${base}/`} aria-label="Avery Moon home">
      <span class="brand-mark">AM</span><span class="brand-name">Avery Moon</span>
    </a>
    <button class="menu" type="button" aria-expanded="false" aria-controls="main-nav">Menu</button>
    <ul class="navlinks" id="main-nav">
      {nav.map(item => {
        const href = hrefFor(item.href);
        const active = item.href === '/' ? path === `${base}/` || path === `${base}` : path.startsWith(`${base}${item.href}`);
        return <li><a href={href} class:list={{active}}>{item.label}</a></li>
      })}
    </ul>
  </div>
</header>
