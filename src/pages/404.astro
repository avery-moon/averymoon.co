---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout title="Page Not Found">
<section class="section"><div class="container"><div class="page-hero"><div class="eyebrow">404</div><h1>This page wandered off.</h1><p><a class="button primary" href={`${base}/`}>Back home</a></p></div></div></section>
</BaseLayout>
