---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const projects = [
  {
    no:'01', title:'ICQA Manager Handoff Playbook', area:'Knowledge Stewardship',
    meta:'Transition Guide · ~15–20 pages',
    body:'Created a structured transition playbook to consolidate recurring responsibilities, operational knowledge, key processes, and resources for the next manager inheriting the function.',
    tags:['Knowledge Transfer','Documentation','Role Transition']
  },
  {
    no:'02', title:'Operational Quality Bootcamps', area:'Learning Design',
    meta:'4 Department-Specific Bootcamps · ~4 Hours Each',
    body:'Designed and developed four distinct quality-training bootcamps for Inbound, Outbound, PCF, and ICQA operational leaders, each with its own approximately 120-slide presentation and four-hour session. Translated quality metrics, defect pathways, root-cause analysis, and corrective actions into department-specific learning. After the building launched, followed up with targeted quality action items for each group based on its poorest-performing metrics.',
    tags:['Learning Design','Quality','Root Cause Analysis']
  },
  {
    no:'03', title:'Multilingual Visual Knowledge Guides', area:'Accessible Knowledge',
    meta:'Frontline Reference · 3 Languages',
    body:'Designed visual point-of-work resources to make complex operational procedures easier to use in practice, including materials adapted into three languages for a multilingual frontline workforce.',
    tags:['Visual Documentation','Accessibility','Frontline Use']
  },
  {
    no:'04', title:'Internal Knowledge Resource Pages', area:'Knowledge Management',
    meta:'Living Knowledge Resource',
    body:'Grew and maintained internal wiki-style resource pages that centralized frequently needed operational knowledge and kept reference material useful as processes evolved.',
    tags:['Knowledge Architecture','Self-Service','Information Design']
  },
  {
    no:'05', title:'Standardized Process Documentation', area:'Process Design',
    meta:'Multi-Site / National Scope',
    body:'Developed standardized documentation for inter-building inventory transfers and discrepancy handling across multiple sites.',
    tags:['SOP Design','Standardization','Cross-Site Operations']
  },
  {
    no:'06', title:'Problem Solve Cross-Training Planner', area:'Capability Planning',
    meta:'Cross-Training Planning',
    body:'Built a lightweight planner to make cross-training needs and functional coverage easier to see across Problem Solve roles.',
    tags:['Cross-Training','Capability Visibility','Workforce Planning']
  }
];
---
<BaseLayout title="Selected Projects" description="Selected knowledge, learning, documentation, and systems projects by Avery Moon, including professional work described at a high level where source materials are proprietary.">
<section class="selected-hero selected-hero-final">
  <div class="container selected-hero-grid">
    <div class="selected-hero-main">
      <div class="case-kicker">Selected Projects</div>
      <h1>Smaller projects.<br/><em>Same systems thinking.</em></h1>
      <p class="selected-subhead">Smaller examples of how I've approached documentation, learning, knowledge sharing, and systems design.</p>
    </div>

    <p class="selected-discretion selected-hero-note">Some professional source materials are proprietary. Those projects are described at a high level rather than reproduced.</p>
  </div>
</section>

<section class="selected-index">
  <div class="container">
    <div class="selected-index-head">
      <span>Selected professional work · Amazon, 2021–2025</span>
      <span>Knowledge · Learning · Documentation · Capability</span>
    </div>

    <article class="selected-feature selected-feature-text">
      <div class="selected-feature-copy">
        <div class="selected-card-top">
          <span class="selected-no">{projects[0].no}</span>
          <span class="selected-area">{projects[0].area}</span>
        </div>
        <div class="selected-meta">{projects[0].meta}</div>
        <h2>{projects[0].title}</h2>
      </div>
      <div class="selected-feature-detail">
        <p>{projects[0].body}</p>
        <div class="selected-tags">
          {projects[0].tags.map(tag => <span>{tag}</span>)}
        </div>
      </div>
    </article>

    <div class="selected-subhead">
      <span>Knowledge + Learning</span>
      <span>02—05</span>
    </div>
    <div class="selected-grid selected-grid-four">
      {projects.slice(1,5).map(project => (
        <article class="selected-card">
          <div class="selected-card-top">
            <span class="selected-no">{project.no}</span>
            <span class="selected-area">{project.area}</span>
          </div>
          <div class="selected-card-body">
            <div class="selected-meta">{project.meta}</div>
            <h2>{project.title}</h2>
            <p>{project.body}</p>
          </div>
          <div class="selected-tags">
            {project.tags.map(tag => <span>{tag}</span>)}
          </div>
        </article>
      ))}
    </div>

    <div class="selected-subhead">
      <span>Capability Planning</span>
      <span>06</span>
    </div>
    <article class="selected-wide-card">
      <div>
        <div class="selected-card-top">
          <span class="selected-no">{projects[5].no}</span>
          <span class="selected-area">{projects[5].area}</span>
        </div>
        <div class="selected-meta">{projects[5].meta}</div>
        <h2>{projects[5].title}</h2>
      </div>
      <div>
        <p>{projects[5].body}</p>
        <div class="selected-tags">
          {projects[5].tags.map(tag => <span>{tag}</span>)}
        </div>
      </div>
    </article>
  </div>
</section>


<section class="selected-community">
  <div class="container">
    <div class="selected-subhead"><span>Community Partnerships</span><span>07</span></div>
    <a class="community-feature" href="/selected-projects/latino-family-center/">
      <div class="community-heading"><span class="community-index">07 · Community Program Development · 2019</span><h2>Learning Resources for the Latino Family Center</h2><p>A collaborative education project that turned stakeholder feedback into reusable art and STEM curricula and a coordinated four-week supply drive.</p></div>
      <div class="community-aside"><span>2 curriculum binders</span><span>520+ supplies donated</span><strong>Explore the case study →</strong></div>
    </a>
  </div>
</section>
<style>
.selected-community{padding:32px 0 58px;background:#f4f0e8}.community-feature{display:grid;grid-template-columns:1.6fr .65fr;gap:35px;padding:28px 32px;background:#f9f7f1;border:1px solid rgba(32,59,49,.17);color:#203b31;text-decoration:none;transition:background .2s}.community-feature:hover{background:#ebece3}.community-index{color:#a05239;font-size:.67rem;letter-spacing:.12em;text-transform:uppercase;font-weight:800}.community-feature h2{font-size:clamp(1.75rem,3vw,2.5rem);margin:12px 0}.community-feature p{max-width:620px;color:#5c665b;margin:0}.community-aside{display:flex;flex-direction:column;gap:9px;align-items:flex-start;justify-content:center;font-size:.82rem;color:#596859}.community-aside strong{margin-top:15px;color:#a05239}@media(max-width:700px){.community-feature{grid-template-columns:1fr;padding:22px;gap:18px}.community-aside strong{margin-top:6px}}
</style>

<section class="selected-future">
  <div class="container selected-future-grid">
    <div>
      <div class="case-kicker">An Expanding Collection</div>
      <h2>The work continues in<br/><em>new technical directions.</em></h2>
    </div>
    <div>
      <p>An evolving collection of projects exploring new tools, technical methods, and ways of turning information into useful systems.</p>
      <div class="future-tracks">
        <span>AI Product Development</span>
        <span>Data + SQL</span>
        <span>GIS + Spatial Analysis</span>
        <span>Future Builds</span>
      </div>
    </div>
  </div>
</section>

<section class="case-next">
  <div class="container">
    <span class="eyebrow">Deeper Case Studies</span>
    <a href={`${base}/built-systems/`}><strong>Explore Built Systems</strong><span>→</span></a>
  </div>
</section>
</BaseLayout>
