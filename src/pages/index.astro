---
import BaseLayout from '../layouts/BaseLayout.astro';
import TheoryStrip from '../components/TheoryStrip.astro';
import SystemCard from '../components/SystemCard.astro';
import { systems } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout title="Home">
<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <div class="eyebrow">Systems Thinking · Knowledge · Process Design</div>
      <h1>Designing systems that help organizations <span class="accent"><em>work smarter.</em></span></h1>
      <p>I'm Avery Moon. I design, document, and improve the systems that help people find what they need, make better decisions, and do complex work more clearly.</p>
      <div class="hero-actions">
        <a class="button primary" href={`${base}/built-systems/`}>Explore Built Systems</a>
        <a class="button" href={`${base}/about/`}>About Me</a>
      </div>
      <div class="descriptors"><span>Systems Thinking</span><span>Knowledge</span><span>Process Design</span></div>
    </div>
    <div class="hero-art">
      <img src={`${base}/images/hero-organic-systems.jpg`} alt="Abstract river system with topographic, geometric, and botanical elements" />
      <div class="hero-orbit-note">Good structure creates clarity without eliminating judgment.</div>
    </div>
  </div>
</section>

<TheoryStrip />

<section class="section">
  <div class="container split-intro reveal">
    <div><div class="eyebrow">How I work</div><p class="big-thought">I build the connective tissue between people, information, and work.</p></div>
    <div>
      <p>My work sits at the intersection of systems thinking, process design, knowledge stewardship, and organizational effectiveness. I'm most useful when the work is complex, information is scattered, and a team needs structure that makes the next decision easier.</p>
      <a class="button" href={`${base}/approach/`}>Explore My Approach</a>
    </div>
  </div>
</section>

<section class="section alt">
  <div class="container">
    <div class="eyebrow">What I bring</div>
    <div class="pillars reveal">
      <div class="pillar"><div class="pillar-icon">⌁</div><h3>Systems Thinking</h3><p>See relationships, constraints, and the larger system behind a problem.</p></div>
      <div class="pillar"><div class="pillar-icon">▤</div><h3>Knowledge Management</h3><p>Make information findable, usable, transferable, and durable.</p></div>
      <div class="pillar"><div class="pillar-icon">⌘</div><h3>Process Design</h3><p>Turn ambiguity into structures that reflect how work actually happens.</p></div>
      <div class="pillar"><div class="pillar-icon">↗</div><h3>Measurable Results</h3><p>Use evidence to learn, refine, and strengthen what gets built.</p></div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="eyebrow">Selected work</div>
    <h2>Built Systems</h2>
    <p class="muted">Real systems designed to solve real problems.</p>
    <div class="system-grid">{systems.map(system => <SystemCard system={system} />)}</div>
  </div>
</section>
</BaseLayout>
