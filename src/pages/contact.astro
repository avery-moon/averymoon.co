---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact">
<section class="contact-v57">
  <div class="container">
    <header class="contact-head">
      <div class="eyebrow">Contact</div>
      <h1>Let's talk about the work.</h1>
      <p>If you're building a team, untangling a process, organizing knowledge, or trying to make a complex system easier to use, I'd be glad to connect.</p>
    </header>

    <div class="contact-rule"></div>

    <div class="contact-links">
      <a href="mailto:aemoon01@gmail.com" class="contact-row">
        <span class="contact-index">01</span><span class="contact-type">Email</span>
        <strong>aemoon01@gmail.com</strong><span class="contact-arrow">↗</span>
      </a>
      <a href="https://www.linkedin.com/in/avery-moon" target="_blank" rel="noopener" class="contact-row">
        <span class="contact-index">02</span><span class="contact-type">LinkedIn</span>
        <strong>linkedin.com/in/avery-moon</strong><span class="contact-arrow">↗</span>
      </a>
      <a href="https://github.com/avery-moon" target="_blank" rel="noopener" class="contact-row">
        <span class="contact-index">03</span><span class="contact-type">GitHub</span>
        <strong>github.com/avery-moon</strong><span class="contact-arrow">↗</span>
      </a>
    </div>

    <div class="contact-close">
      <span>Systems · Knowledge · Process</span>
      <span>Better systems. Better outcomes. Stronger teams.</span>
    </div>
  </div>
</section>
</BaseLayout>
