---
import BaseLayout from '../layouts/BaseLayout.astro';
import { papers } from '../data/site';
---
<BaseLayout title="Research & Writing">
<section class="research-v53"><div class="container">
<div class="compact-page-label"><span class="eyebrow research-label">Research & Writing / Selected Work</span><span class="research-meta">International Relations · Sociology / Anthropology · Published Research</span></div>
<a class="atlas-feature" href="/research-writing/mapping-educational-access/"><span>FEATURED RESEARCH / 2018 · HIGH POINT, NORTH CAROLINA</span><strong>Mapping Educational Access <em>↗</em></strong><p>A collaborative investigation of student mobility, transportation barriers, and school reassignment policy—revisited through a spatial and systems-design lens.</p><small>PUBLIC POLICY · TRANSPORTATION · RESEARCH METHODS · EDUCATIONAL EQUITY</small></a>
<article class="literary-feature"><div class="meta">LITERARY ANALYSIS · 2020</div><h2><a href="/research-writing/class-belonging-american-dream/">Class, Belonging, and the American Dream</a></h2><p>A close reading of Anzia Yezierska’s <em>Bread Givers</em>, examining how names, word choice, and pronouns express class divisions and the experience of being an outsider.</p><a href="/research-writing/class-belonging-american-dream/">Read the essay ↗</a></article>
<div class="paper-grid">{papers.map((paper,i)=><article class="paper reveal"><div class="meta">0{i+1} · {paper.meta}</div><h3>{paper.title}</h3><p>{paper.description}</p><a href={paper.url} target="_blank" rel="noopener">Read on JSTOR ↗</a></article>)}</div>
</div></section>
<style>.literary-feature{max-width:820px;margin:0 0 60px;padding:0 0 36px;border-bottom:1px solid var(--line)}.literary-feature h2{font:normal clamp(2rem,4vw,3rem)/1.15 Georgia,serif;color:var(--forest);margin:14px 0}.literary-feature h2 a{text-decoration:none}.literary-feature p{max-width:690px}.literary-feature>.meta{font-size:.7rem;letter-spacing:.13em;color:var(--muted)}.atlas-feature{display:block;background:#1c3b35;color:#eeeae0;padding:clamp(26px,5vw,60px);margin:26px 0 60px;text-decoration:none;position:relative;overflow:hidden}.atlas-feature:after{content:"";position:absolute;border:1px solid #87a79677;border-radius:50%;width:400px;height:400px;right:-180px;top:-160px;pointer-events:none}.atlas-feature span,.atlas-feature small{display:block;color:#bed0be;font-size:.67rem;letter-spacing:.16em;font-weight:700}.atlas-feature strong{display:block;color:#f3f0e7;font:normal clamp(2.5rem,5vw,4.5rem)/1.05 Georgia,serif;letter-spacing:-.04em;max-width:750px;margin:28px 0 20px}.atlas-feature strong em{font-size:.65em;color:#d8b28e}.atlas-feature p{max-width:640px;font-size:1.07rem;color:#d7e1d5}.atlas-feature small{margin-top:32px}.atlas-feature:hover{background:#24483f}</style>
</BaseLayout>
