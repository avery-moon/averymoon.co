---
import BaseLayout from '../layouts/BaseLayout.astro';
import { papers } from '../data/site';
---
<BaseLayout title="Research & Writing">
<section class="section"><div class="container">
  <div class="page-hero"><div class="eyebrow">Research & Writing</div><h1>Earlier research into identity, culture, economics, and the systems shaping human experience.</h1><p>Before my professional work centered on organizational systems, my academic research explored a different scale of systems: nations, economies, culture, identity, and socioeconomic structures.</p></div>
  <div class="paper-grid">
    {papers.map((paper, i) => <article class="paper reveal"><div class="meta">0{i+1} · {paper.meta}</div><h3>{paper.title}</h3><p>{paper.description}</p><a href={paper.url} target="_blank" rel="noopener">Read on JSTOR ↗</a></article>)}
  </div>
</div></section>
</BaseLayout>
