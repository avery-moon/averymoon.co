---
const { system } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<a class="system-card reveal" href={`${base}/built-systems/${system.slug}/`}>
  <div class="meta">{system.number} · {system.category}</div>
  <h3>{system.title}</h3>
  <p class="muted">{system.summary}</p>
  <div class="metric">{system.metric}</div>
  <span class="arrow">↗</span>
</a>
