---
const { system } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const glyphs = {
  // Demand + inventory streams converge into a forward planning horizon.
  'alloy-procurement': 'M10 26h28l18 22h20M10 70h28l18-22M76 48h42M94 34l24 14-24 14',
  // A staged learning pathway culminates in qualification.
  'onboarding-certification': 'M12 86h22V70h22V54h22V38h22V22h18M25 86V34M25 34l10 10M25 34L15 44M103 22l7 7 13-17',
  // Multiple material groups feed a centralized inventory/control view.
  'foundry-inventory': 'M12 25h25v18H12zM12 54h25v18H12zM12 83h25v18H12zM37 34h20M37 63h20M37 92h20M57 25h58v76H57zM72 43h29M72 58h21M72 73h33M72 88h25',
  // Capability matrix with deliberate open gaps.
  'cross-training-matrix': 'M14 18h102v84H14zM14 46h102M14 74h102M47 18v84M81 18v84M24 30h13M57 58h14M91 30h15M24 86h13M91 86h15',
  // Operating timeline interrupted by downtime spikes / loss events.
  'equipment-downtime-dashboard': 'M10 86h108M14 70l18-2 8-34 9 50 11-14 13-2 8-40 10 58 11-26 12 2 11-9M32 20v66M76 20v66M108 20v66',
  // People/resources allocated across a time grid.
  'workforce-scheduling': 'M12 22h106v82H12zM12 43h106M42 22v82M68 22v82M94 22v82M20 52h14v13H20zM48 72h14v13H48zM74 52h14v13H74zM100 86h12v10h-12z'
};
const glyph = glyphs[system.slug];
---
<a class="system-card reveal" href={`${base}/built-systems/${system.slug}/`}>
  <div class="system-signature-field" aria-hidden="true"><div class="system-signature">
    <svg viewBox="0 0 130 120"><path d={glyph}/></svg>
  </div></div>
  <div class="meta">{system.category}</div>
  <h3>{system.title}</h3>
  <div class="metric metric-v56">{system.metric}</div>
  <p class="muted card-summary">{system.summary}</p>
  <div class="card-gateway"><span>Explore system</span><span>→</span></div>
</a>
